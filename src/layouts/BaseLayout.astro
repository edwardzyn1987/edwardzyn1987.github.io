---
import Header from '../components/Header.astro';

interface Props {
  title: string;
  description?: string;
}

const { title, description = '古体诗词个人展示' } = Astro.props;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title} | 隐恕诗笺</title>
  </head>
  <body>
    <Header />
    <slot />
  </body>
</html>

<!-- 全站访问统计：GoatCounter 埋点脚本（自动记录每次页面访问的 PV/UV）。
     数据源统一为 GoatCounter：诗页读回本页阅读数、「关于」页读回全站总数（TOTAL），都来自这里的埋点。
     count.js 自动按 location.pathname 记录，无需手动去重；本地 dev 环境不发送（allow_local 未开）。
     ⚠️ 自托管 count.js（/count.js，同源）：公共 CDN gc.zgo.at 在国内网络会 ERR_CONNECTION_TIMED_OUT，
     脚本加载不了则埋点从不发出、计数永远 0。同源脚本必然可加载，绕过 gc.zgo.at。
     上报端点仍是 edwardpoetry.goatcounter.com/count（data-goatcounter），/count 官方保证向后兼容。 -->
<script
  data-goatcounter="https://edwardpoetry.goatcounter.com/count"
  async
  src="/count.js"></script>

<style is:global>
  @import '../styles/global.css';
</style>
