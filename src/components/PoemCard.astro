---
interface Props {
  title: string;
  slug: string;
  category: string;
  tags: string[];
  date: Date;
  excerpt: string;
  hasVideo: boolean;
}

const { title, slug, category, tags, date, excerpt, hasVideo } = Astro.props;

const dateStr = date.toLocaleDateString('zh-CN', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<a href={`/poems/${slug}`} class="poem-card">
  <div class="poem-card-header">
    <h3 class="poem-card-title">{title}</h3>
    {hasVideo && <span class="video-badge" title="有朗诵视频">🎬</span>}
  </div>
  <p class="poem-card-excerpt">{excerpt}</p>
  <div class="poem-card-footer">
    <div class="poem-card-tags">
      <span class="tag">{category}</span>
      {tags.map(tag => <span class="tag">{tag}</span>)}
    </div>
    <span class="poem-card-date">{dateStr}</span>
  </div>
</a>

